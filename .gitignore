# Python
.venv/
# isolated region-prep stack (requirements-regionprep.txt)
.venv-prep/
.venv-ci/
__pycache__/
*.py[cod]
.pytest_cache/

# The DEM is the one large regenerable asset (see sources.json to verify a rebuild).
# landcover.tif is small (<1 MB) and IS committed -- no broad *.tif rule.
regions/*/dem.tif

# packed terrain plates are release assets, not repo content (plates/index.json
# stays tracked -- the hashes belong in history even if the zips move hosts)
plates/*.trailplate.zip

# requests-cache from the NHD/3DEP fetches
cache/

# user-uploaded marker photos (single-user local app) — root only, so it
# doesn't swallow doc folders that happen to contain an "uploads/" subdir
/uploads/

# server-foundation local stores (blob outputs + sqlite session db)
blobs/
*.db

# OS
.DS_Store

# generated marketing asset farm (scripts/render_asset_farm.py)
assets/

# built macOS launcher app (scripts/macos/build_app.sh)
/dist/

# ---- Licensed fonts: never commit, this repo is PUBLIC ----
# MB Type licence paragraph 7 forbids storing the fonts in a location reachable
# by non-licensed users, naming "a source repository" explicitly. This repo is
# public and AGPL, which compounds it: copyleft obligates granting recipients
# the right to redistribute the whole work, and that right cannot be granted
# over these faces.
#
# The design already handles this. TECOPA_FONT (app/render.py) is an
# operator-side override that points at a licensed face on Dom's own machine,
# with a freely-redistributable default in the shipped path. These patterns
# exist so the rule is enforced rather than remembered -- git history is
# permanent, and a font committed once is exposed forever.
*.otf
*.ttf
*.woff
*.woff2
